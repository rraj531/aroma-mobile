    "description": "Complete API collection for Aroma Mobile & Electronics backend. Base URL: http://localhost:5000\n\nTotal APIs: 34\n\nCategories:\n1. Auth (5)\n2. Products (3)\n3. Cart (5)\n4. Wishlist (3)\n5. Address (5)\n6. Orders (4)\n7. Payment (2)\n8. Coupons (3)\n9. Reviews (3)\n10. Admin (5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token - auto set after login"
    },
    {
      "key": "productId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "addressId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "1",
      "type": "string"
    }
